# --- Database (Postgres) -----------------------------------------------------
# This project runs on Neon. Neon Dashboard -> your project -> Connection string.
# Neon gives you two URLs: use the pooled "-pooler" host for the app at runtime,
# and the direct (non-pooling) host for schema changes (prisma db push), which
# hang on the pooled URL. Any Postgres works (Supabase, Vercel Postgres) too.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Email (Resend) ----------------------------------------------------------
# Get a key at https://resend.com/api-keys. Without a verified domain you can
# send from onboarding@resend.dev to your own address for testing.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="VenueNest Waitlist <onboarding@resend.dev>"
# Signing secret from the Resend dashboard webhook (Webhooks -> your endpoint).
# Enables /api/webhooks/resend to verify + record delivery/bounce/open status.
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# --- Admin view --------------------------------------------------------------
ADMIN_PASSWORD="change-me"
# Any random string; rotating it logs everyone out of /admin.
ADMIN_SECRET="generate-a-long-random-string"
