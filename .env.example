# --- Database (Postgres) -----------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI (use the
# pooled "Transaction" connection on port 6543 for serverless/Vercel).
# Or Vercel Postgres: copy POSTGRES_PRISMA_URL into DATABASE_URL.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&sslmode=require"

# --- Email (Resend) ----------------------------------------------------------
# Get a key at https://resend.com/api-keys. Without a verified domain you can
# send from onboarding@resend.dev to your own address for testing.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="VenueNest Waitlist <onboarding@resend.dev>"

# --- Admin view --------------------------------------------------------------
ADMIN_PASSWORD="change-me"
# Any random string; rotating it logs everyone out of /admin.
ADMIN_SECRET="generate-a-long-random-string"
